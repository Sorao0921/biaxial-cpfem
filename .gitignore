# Generated simulation models, analysis data, catalogs, and exports.
# Keep local files; version only source, documentation, and base configuration.
/models/
/outputs/
/output/
/database/

# Solver decks (inputs rules below retain their previous behavior).
*.k

# External installations and solver output.
/src/mtex-*/
*.exe
*.dll
**/run/
d3plot*
d3dump*
d3full*

# Python environments, packaging, and caches.
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*.so
*.egg-info/
*.egg
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ipynb_checkpoints/

# Local settings and secrets.
.env
.env.*
!.env.example
.idea/
.vscode/
/private/
.DS_Store

